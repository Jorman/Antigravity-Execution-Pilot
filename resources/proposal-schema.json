{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CommandGovernanceProposal",
  "type": "object",
  "required": ["proposalId", "version", "scope", "status", "pattern", "category", "action"],
  "properties": {
    "proposalId": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "scope": { "type": "string", "enum": ["global", "workspace"] },
    "status": { "type": "string", "enum": ["pending", "accepted", "rejected", "retired"] },
    "pattern": { "type": "string" },
    "category": { "type": "string" },
    "shells": { "type": "array", "items": { "type": "string" } },
    "platforms": { "type": "array", "items": { "type": "string" } },
    "cause": { "type": "string" },
    "action": { "type": "string" },
    "alternative": { "type": "string" },
    "evidenceCount": { "type": "integer", "minimum": 0 },
    "firstObserved": { "type": "string" },
    "lastObserved": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "risk": { "type": "string", "enum": ["low", "medium", "high"] },
    "regressionTests": { "type": "array", "items": { "type": "string" } },
    "expiresAt": { "type": "string" },
    "lastValidated": { "type": "string" },
    "rollbackAvailable": { "type": "boolean" }
  }
}
